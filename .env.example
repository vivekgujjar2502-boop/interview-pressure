# Database — local SQLite file (used in development, auto-created)
# DATABASE_URL=file:./data.db

# For Vercel production, use Turso (libsql):
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# Optional: Ollama AI (for question generation + answer evaluation)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# Optional: enable dev-mode password reset tokens in forgot-password response
# RESET_DEV_MODE=true

# InterviewPressure backend configuration (local/free only - no API keys needed)
# Copy this file to `.env` (same folder) to override the defaults.

# --- Database ---
# Default: SQLite file next to database.py
# DATABASE_URL=sqlite:///./interview_pressure.db

# --- Local Ollama LLM (question generation + answer evaluation) ---
# Base URL of your locally running Ollama server.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Small model that runs on a normal Windows PC (~2 GB download):
#   ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
# Max seconds to wait for an AI response (CPU can be slow).
OLLAMA_TIMEOUT=180

# --- Local Whisper speech-to-text (voice answers) ---
# Model size: tiny.en | base.en | small.en  (base.en is a good default,
# ~80 MB, downloaded automatically on first use).
WHISPER_MODEL=base.en

# --- Sessions & auth ---
# Login session lifetime in days.
SESSION_LIFETIME_DAYS=30
# true: password reset tokens are returned by the API directly because no
# email provider is configured (LOCAL DEVELOPMENT ONLY).
# false: the API never reveals reset tokens.
RESET_DEV_MODE=true
